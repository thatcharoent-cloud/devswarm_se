# =============================================================================
# DevSwarm Configuration (Hybrid Software Engineering Swarm)
# Local coding agents (Ollama 16 GB Apple Silicon) + Optional Cloud Specialists (PM, Architect, QA)
# =============================================================================

# LLM Endpoint (Ollama Local Daemon for coding agents)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Active Models
MODEL=qwen3.5:9b
ORCHESTRATOR_MODEL=qwen3.5:9b
REVIEWER_MODEL=qwen3.5:9b

# Inference & Small-Context Settings (16 GB Apple Silicon Profile)
NUM_CTX=16384
NUM_PREDICT=2048
LLM_CONCURRENCY=1
THINKING_WORKERS=off
THINKING_ORCHESTRATOR=off

# =============================================================================
# Cloud Specialist Roles (PM, Architect, QA, Reviewer, Debugger)
# API Keys come strictly from environment or .env (never in prompts, git, or sandboxes)
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
GEMINI_API_KEY=

# Cloud Financial Dollar Budgeting (USD)
MAX_CLOUD_USD=5.00

# Optional Model Pricing Overrides ($ per million tokens)
# Format: PRICE_INPUT_<CLEAN_MODEL_NAME> and PRICE_OUTPUT_<CLEAN_MODEL_NAME>
# PRICE_INPUT_CLAUDE_3_5_SONNET=3.00
# PRICE_OUTPUT_CLAUDE_3_5_SONNET=15.00

# =============================================================================
# Host-Side Web Research Tools (Safe fetch, SSRF protection, SQLite FTS5 docs cache)
# Backends: "searxng" (local, default, no key) or "brave" (key-based)
# =============================================================================
SEARCH_BACKEND=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
BRAVE_API_KEY=
MAX_SEARCHES=10
MAX_FETCHES=15
MAX_FETCH_BYTES=1000000

# =============================================================================
# Self-Healing & Escalation
# =============================================================================
MAX_FIX_ATTEMPTS=2

# Task DAG & Context Compaction Controls
MAX_FILES_PER_TASK=2
MAX_TURNS=12
TOOL_OUTPUT_MAX_TOKENS=1500
REPO_MAP_MAX_TOKENS=1500
COMPACT_AT_PCT=70

# Timeouts & Safety Guards
MAX_RUN_MINUTES=45
MAX_TASK_MINUTES=10
MIN_TOKENS_PER_SEC=5
UNLOAD_MODEL_EVERY_N_TASKS=3
OLLAMA_STALL_TIMEOUT_S=60.0
OLLAMA_LOAD_TIMEOUT_S=180.0

# Sandbox Defaults (Isolated Docker environment)
SANDBOX_IMAGE=devswarm-sandbox:latest
SANDBOX_MEMORY=1g
SANDBOX_CPUS=2
